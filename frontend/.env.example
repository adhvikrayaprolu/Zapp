# Supabase project URL. In production, must remain a non-loopback https:// origin.
VITE_SUPABASE_URL=https://abcdxyz123.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
# Backend API base URL (no trailing slash). Used by src/api/client.ts and src/api/ai.api.ts.
# Development-only example below. Keep the host aligned with the backend OAuth callback
# and the frontend dev origin (`127.0.0.1` across both apps)
# so the session cookie and OAuth callback stay on the same loopback host.
# In production builds, must be https and must not use 127.0.0.1 or other loopback hosts.
VITE_API_URL=http://127.0.0.1:8000

# Public site origin (no trailing slash). Used at build time to generate absolute
# URLs in sitemap.xml, robots.txt, and the canonical/Open Graph tags. In
# production this must be the real https origin (never localhost/127.0.0.1).
VITE_SITE_URL=https://app.your-domain.com

# Privacy policy metadata fallback (backend /api/compliance/privacy-policy/ is authoritative)
# VITE_PRIVACY_POLICY_URL=https://your-domain.com/privacy
# VITE_PRIVACY_POLICY_VERSION=1.0.0
# VITE_PRIVACY_POLICY_EFFECTIVE_DATE=2026-01-01
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_PRIVACY_EMAIL=privacy@example.com
